{
  "Rules": [
    {
      "ID": "DeleteMultipartUploads",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "patient-documents/"
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 1
      }
    },
    {
      "ID": "DeleteOldDocuments",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "patient-documents/"
      },
      "Expiration": {
        "Days": 365
      }
    }
  ]
}

